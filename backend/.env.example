# Server
PORT=4000
NODE_ENV=development

# PostgreSQL (docker compose maps host 5434 -> container 5432)
DATABASE_URL=postgres://fairwork:fairwork@127.0.0.1:5434/fairwork

# JWT — generate a long random string for local use; never commit real secrets
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS — frontend origin
CORS_ORIGIN=http://localhost:5173

# Private file storage (submissions + dispute evidence). Empty = backend/storage/private
STORAGE_PRIVATE_DIR=
MAX_UPLOAD_BYTES=10485760

# Blockchain (Phase 17+) — local/test network only; leave blank to disable verification
# Example after: cd contracts && npx hardhat node && npx hardhat run scripts/deploy-local.js --network localhost
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
ESCROW_CONTRACT_ADDRESS=
TOKEN_DECIMALS=6

# Phase 19 — local Ollama AI (never auto-downloads weights)
AI_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_MS=60000
AI_MODEL_CODE=qwen2.5-coder:1.5b
AI_MODEL_TEXT=qwen3:1.7b,gemma3:1b
AI_MODEL_VISUAL=qwen2.5vl:3b,gemma3:4b
AI_COMPARE_ON_LOW_CONFIDENCE=true
AI_LOW_CONFIDENCE_THRESHOLD=0.55

# Deterministic deadline/inactivity notifications (independent of AI)
NOTIFICATION_JOB_ENABLED=true
NOTIFICATION_JOB_INTERVAL_MS=300000
DEADLINE_WARN_DAYS=3
INACTIVITY_DAYS=7

# Phase 21 — Gateway Payments (Razorpay Sandbox)
GATEWAY_PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret
PAYOUT_MODE=simulated

